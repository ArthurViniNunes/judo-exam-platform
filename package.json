{
  "name": "judo-exam-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "dev:all": "node scripts/dev-all.mjs",
    "dev:lan": "node scripts/dev-all.mjs --lan",
    "build": "next build",
    "start": "node scripts/serve-static.mjs out 3000",
    "start:lan": "node scripts/serve-static.mjs out 3000 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "backend:types": "wrangler types backend/worker-configuration.d.ts --config backend/wrangler.jsonc --include-runtime false --strict-vars false",
    "backend:dev": "wrangler dev --config backend/wrangler.jsonc --local --persist-to .wrangler/state --port 8787",
    "backend:migrate:local": "wrangler d1 migrations apply judo-exam-db --local --config backend/wrangler.jsonc --persist-to .wrangler/state",
    "backend:migrate:remote": "wrangler d1 migrations apply judo-exam-db --remote --config backend/wrangler.jsonc",
    "backend:deploy": "wrangler deploy --config backend/wrangler.jsonc",
    "frontend:deploy": "wrangler deploy --config wrangler.frontend.jsonc"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "wrangler": "4.151.1"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0"
}
