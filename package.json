{
  "name": "judo-exam-platform",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3000",
    "dev:all": "node scripts/dev-all.mjs",
    "build": "next build",
    "start": "node scripts/serve-static.mjs out 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "backend:dev": "wrangler dev --config backend/wrangler.jsonc --local --persist-to .wrangler/state --port 8787",
    "backend:migrate:local": "wrangler d1 migrations apply judo-exam-db --local --config backend/wrangler.jsonc --persist-to .wrangler/state",
    "backend:migrate:remote": "wrangler d1 migrations apply judo-exam-db --remote --config backend/wrangler.jsonc",
    "backend:deploy": "wrangler deploy --config backend/wrangler.jsonc"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
