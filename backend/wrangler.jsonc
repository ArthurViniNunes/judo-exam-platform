{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "judo-exam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "FRONTEND_ORIGIN": "https://judo-exam-platform.judo-rogerio-cruz.workers.dev",
    "PUBLIC_APP_URL": "https://judo-exam-platform.judo-rogerio-cruz.workers.dev",
    "EMAIL_FROM_ADDRESS": "admin@judorogeriocruz.com.br",
    "EMAIL_FROM_NAME": "Judô Rogério Cruz",
    "SUPER_ADMIN_EMAIL": "admin@judorogeriocruz.com.br",
    "THEORY_EXAMS_ENABLED": "true"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "judo-exam-db",
      "database_id": "931ec123-99d2-4fab-a04f-7a82206d1ee1",
      "migrations_dir": "migrations"
    }
  ]
}
