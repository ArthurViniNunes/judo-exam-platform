{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "judo-exam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-05-22",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "FRONTEND_ORIGIN": "https://judo-exam-platform.judo-rogerio-cruz.workers.dev",
    "SUPER_ADMIN_EMAIL": "admin@judorogeriocruz.com.br"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "judo-exam-db",
      "database_id": "931ec123-99d2-4fab-a04f-7a82206d1ee1",
      "migrations_dir": "migrations"
    }
  ]
}
